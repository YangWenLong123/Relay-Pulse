{
  "manifest_version": 3,
  "name": "Relay Pulse - AI 中转站连接测试",
  "short_name": "Relay Pulse",
  "version": "1.0.0",
  "description": "管理并测试 OpenAI 兼容中转站的 URL、API Key 和模型连接。",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开 Relay Pulse",
    "default_popup": "launcher.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http: https:"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "relay-pulse@local",
      "strict_min_version": "109.0"
    }
  }
}
