{
  "name": "relay-pulse-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:extension": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode extension",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --pretty false",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.5",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "pinia": "^2.2.2",
    "vue": "^3.5.4",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "@vitest/coverage-v8": "^2.1.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.3",
    "vitest": "^2.1.1",
    "vue-tsc": "^2.1.6"
  }
}
